{
  "name": "propertyflow-remake",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@propertyflow/web run dev",
    "build": "npm --workspace=@propertyflow/web run build && node -e \"const fs=require('fs'); if (fs.existsSync('packages/web/dist')) { fs.mkdirSync('dist', {recursive:true}); fs.cpSync('packages/web/dist', 'dist', {recursive:true}); }\"",
    "start": "npm --workspace=@propertyflow/web run preview",
    "preview": "npm --workspace=@propertyflow/web run preview",
    "lint": "npm --workspace=@propertyflow/web run build",
    "dev:web": "npm --workspace=@propertyflow/web run dev",
    "build:web": "npm --workspace=@propertyflow/web run build",
    "dev:mobile": "npm --workspace=@propertyflow/mobile run start",
    "test": "npm --workspace=@propertyflow/shared run test",
    "build:shared": "npm --workspace=@propertyflow/shared run build",
    "postinstall": "npm --workspace=@propertyflow/mobile run postinstall || true"
  },
  "devDependencies": {
    "@react-native/babel-plugin-codegen": "^0.86.3",
    "@react-native/codegen": "^0.86.3",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "expo-asset": "~57.0.4",
    "expo-blur": "^57.0.3",
    "expo-clipboard": "^57.0.2",
    "expo-font": "~57.0.4",
    "expo-media-library": "~57.0.5",
    "react-native-view-shot": "5.1.0"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
