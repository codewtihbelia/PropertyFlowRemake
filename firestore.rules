rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'SUPER_ADMIN' ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role == 'SUPER_ADMIN')
      );
    }
    
    function isUser(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        userId == ('mem_' + request.auth.uid)
      );
    }

    function isHouseholdHost(householdId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/households/$(householdId)) &&
         'hostId' in get(/databases/$(database)/documents/households/$(householdId)).data &&
         get(/databases/$(database)/documents/households/$(householdId)).data.hostId == request.auth.uid) ||
        (hasUserDoc() &&
         'householdId' in getUserData() && getUserData().householdId == householdId &&
         'role' in getUserData() && getUserData().role == 'HOST')
      );
    }
    
    function isHouseholdMember(householdId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/households/$(householdId)/members/$('mem_' + request.auth.uid)) ||
        (hasUserDoc() && 'householdId' in getUserData() && getUserData().householdId == householdId) ||
        isHouseholdHost(householdId) ||
        isSuperAdmin()
      );
    }
    
    function isHost(householdId) {
      return isAuthenticated() && (
        isHouseholdHost(householdId) ||
        isSuperAdmin()
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isUser(userId) || isSuperAdmin() || isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == userId
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource.data.pendingHouseholdId != null && isHouseholdHost(resource.data.pendingHouseholdId)) ||
        (resource.data.householdId != null && isHouseholdHost(resource.data.householdId))
      );
      allow delete: if isSuperAdmin();

      match /devices/{deviceId} {
        allow read, create, update, delete: if isUser(userId) || isSuperAdmin();
      }
    }

    match /hostApplications/{requestId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          requestId == ('host_app_' + request.auth.uid) ||
          resource == null ||
          resource.data.userId == request.auth.uid
        )
      );
      allow create: if isAuthenticated() && (
        requestId == ('host_app_' + request.auth.uid) ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          requestId == ('host_app_' + request.auth.uid) ||
          resource == null ||
          resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /host_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // Households collection
    match /households/{householdId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isHost(householdId) || isHouseholdMember(householdId) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Subcollection: members
      match /members/{memberId} {
        allow read: if true;
        allow create, update: if isHost(householdId) || isSuperAdmin() || isUser(memberId) || (request.auth.uid != null && request.resource.data.userId == request.auth.uid);
        allow delete: if isHost(householdId) || isSuperAdmin() || isUser(memberId);
      }

      // Subcollection: billingCycles
      match /billingCycles/{cycleId} {
        allow read: if true;
        allow create, update: if isHost(householdId) || isSuperAdmin();
        allow delete: if isHost(householdId) || isSuperAdmin();
      }

      // Subcollection: charges
      match /charges/{chargeId} {
        allow read: if true;
        allow create, update, delete: if isHost(householdId) || isSuperAdmin() || isHouseholdMember(householdId);
      }

      // Subcollection: memberBills
      match /memberBills/{billId} {
        allow read: if true;
        allow create, update: if isHost(householdId) || isSuperAdmin() || isHouseholdMember(householdId);
        allow delete: if false; // Financial snapshot preservation
      }

      // Subcollection: waterAttendance
      match /waterAttendance/{recordId} {
        allow read: if true;
        allow create, update: if isAuthenticated() && (
          isHouseholdMember(householdId) ||
          isHost(householdId) ||
          isSuperAdmin() ||
          request.resource.data.userId == request.auth.uid ||
          isUser(request.resource.data.userId) ||
          (resource != null && (resource.data.userId == request.auth.uid || isUser(resource.data.userId)))
        );
        allow delete: if isHost(householdId) || isSuperAdmin();
      }

      // Subcollection: attendanceSubmissions
      match /attendanceSubmissions/{submissionId} {
        allow read: if true;
        allow create, update: if isAuthenticated() && (
          isHouseholdMember(householdId) ||
          isHost(householdId) ||
          isSuperAdmin() ||
          request.resource.data.userId == request.auth.uid ||
          isUser(request.resource.data.userId) ||
          (resource != null && (resource.data.userId == request.auth.uid || isUser(resource.data.userId)))
        );
        allow delete: if isHost(householdId) || isSuperAdmin();
      }

      // Subcollection: systemSettings (e.g. water config: 5/person/day)
      match /systemSettings/{settingId} {
        allow read: if true;
        allow create, update, delete: if isHost(householdId) || isSuperAdmin() || isHouseholdMember(householdId);
      }

      // Subcollection: electricityConfig
      match /electricityConfig/{configId} {
        allow read: if true;
        allow create, update, delete: if isHost(householdId) || isSuperAdmin();
      }

      // Subcollection: payments
      match /payments/{paymentId} {
        allow read: if true;
        allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isHouseholdMember(householdId));
        allow update: if isHost(householdId) || isSuperAdmin();
        allow delete: if false; // Financial records must never be deleted
      }

      // Subcollection: expenses
      match /expenses/{expenseId} {
        allow read: if true;
        allow create, update, delete: if isHost(householdId) || isSuperAdmin() || isHouseholdMember(householdId);
      }

      // Subcollection: adjustments
      match /adjustments/{adjustmentId} {
        allow read: if true;
        allow create: if isHost(householdId) || isSuperAdmin();
        allow update, delete: if false; // Immutable financial adjustment history
      }

      // Subcollection: announcements
      match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if isHost(householdId) || isSuperAdmin();
      }

      // Subcollection: messages (household group chats & settlement claims)
      match /messages/{messageId} {
        allow read, create, update: if isAuthenticated() && (isHouseholdMember(householdId) || isHost(householdId) || isSuperAdmin());
        allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isHost(householdId) || isSuperAdmin());
      }

      // Subcollection: notes (Facebook Messenger thought notes per roommate)
      match /notes/{noteId} {
        allow read: if true;
        allow create, update: if isAuthenticated() && (
          request.auth.uid == noteId ||
          isHouseholdMember(householdId) ||
          isHost(householdId) ||
          isSuperAdmin()
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == noteId ||
          isHost(householdId) ||
          isSuperAdmin()
        );
      }
    }

    // Invitations
    match /invitations/{invitationId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() &&
        (resource.data.invitedEmail == request.auth.token.email || isHost(resource.data.householdId))
      );
      allow create: if isAuthenticated() && isHost(request.resource.data.householdId);
      allow update: if isAuthenticated() && (
        isHost(resource.data.householdId) ||
        resource.data.invitedEmail == request.auth.token.email
      );
      allow delete: if isSuperAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientId == 'ALL'
      );
      allow create: if isAuthenticated() && (
        request.resource.data.recipientId == request.auth.uid ||
        (request.resource.data.householdId != null && isHouseholdMember(request.resource.data.householdId)) ||
        isHost(request.resource.data.householdId) ||
        isSuperAdmin()
      );
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // Conversations & Messages
    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() && (
        request.auth.uid in resource.data.participantIds ||
        isHouseholdMember(resource.data.householdId)
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participantIds ||
        isHouseholdMember(request.resource.data.householdId)
      );
      
      match /messages/{messageId} {
        allow read, create: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds ||
          isHouseholdMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data.householdId)
        );
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // Support Tickets
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow delete: if isSuperAdmin();

      match /messages/{msgId} {
        allow read, create: if isAuthenticated();
      }
    }

    // App Versions
    match /appVersions/{versionId} {
      allow read: if true; // Public version check for mobile & web
      allow write: if isSuperAdmin();
    }

    // Audit Logs (Immutable)
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && resource.data.householdId != null && isHouseholdMember(resource.data.householdId));
      allow create: if isHost(request.resource.data.householdId) || isSuperAdmin();
      allow update, delete: if false; // Strict immutability
    }

    // System Settings
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
