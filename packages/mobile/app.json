{
  "expo": {
    "name": "Splitzy",
    "slug": "splitzy-mobile",
    "scheme": "splitzy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2782EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splitzy.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2782EA"
      },
      "package": "com.splitzy.app",
      "navigationBar": {
        "visible": "sticky-immersive"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light",
          "enforceContrast": false
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light",
        "hidden": true
      },
      "eas": {
        "projectId": "bc0bb695-d19f-44ed-af2e-4ec21899a49a"
      }
    }
  }
}
